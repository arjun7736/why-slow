{
  "name": "why-api-slow",
  "version": "1.0.7",
  "description": "A high-performance Express middleware to profile slow API requests (DB, External HTTP, and App Logic) with zero configuration. (initial build not completed testing)",
  "license": "MIT",
  "author": "Arjun",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    }
  },
  "scripts": {
    "test": "tsx watch src/test/test-server.ts",
    "clean": "rm -rf dist",
    "build:esm": "tsc -p tsconfig.build.esm.json",
    "build:cjs": "tsc -p tsconfig.build.cjs.json",
    "build:types": "tsc -p tsconfig.build.types.json",
    "build": "npm run clean && npm run build:esm && npm run build:cjs && npm run build:types && npm run build:post",
    "build:post": "printf '{\"type\":\"commonjs\"}\\n' > dist/cjs/package.json",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "express": ">=4.0.0"
  },
  "dependencies": {
    "chalk": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "express": "^5.2.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "express",
    "middleware",
    "performance",
    "profiler",
    "slow-requests",
    "tracing",
    "monitoring",
    "debug"
  ]
}
